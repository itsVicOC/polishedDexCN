# Optional local-only DeepLX endpoint used by `npm run locales` and FULL_GUIDES sync.
# Keep the real URL in .env.local (ignored by Git), never in source or CI logs.
DEEPLX_ENDPOINT=https://your-deeplx-host.example/translate
# Optional comma-separated mirrors tried in order when the primary is
# unavailable or rate-limited.
# DEEPLX_ENDPOINTS=https://mirror-one.example/translate,https://mirror-two.example/translate
# Optional retry tuning for 429 responses.
# DEEPLX_RETRIES=2
# DEEPLX_RETRY_DELAY_MS=1500
# DEEPLX_BATCH_SIZE=12
